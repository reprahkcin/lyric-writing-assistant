# Merriam-Webster API Keys
# To get your API keys:
# 1. Go to https://dictionaryapi.com/
# 2. Register for a free account
# 3. Request API keys for both Dictionary and Thesaurus
# 4. Copy the keys below and rename this file to .env

VUE_APP_DICTIONARY_API_KEY=your_dictionary_api_key_here
VUE_APP_THESAURUS_API_KEY=your_thesaurus_api_key_here
